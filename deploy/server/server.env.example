# R2保护扩展：复制到仓库外的 server.env，填写实际值；不要提交真实文件。
# 教程：docs/server-deployment.md；密钥不放在前端、URL 或 Git 中。
NODE_ENV=production
IMGBED_HOSTING_MODE=server
R2_STORAGE_MODE=cloudflare
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_BUCKET=YOUR_PRIVATE_STANDARD_BUCKET
R2_ACCESS_KEY_ID=REPLACE_WITH_PRIVATE_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_PRIVATE_R2_SECRET_ACCESS_KEY
CF_R2_ANALYTICS_TOKEN=REPLACE_WITH_ACCOUNT_ANALYTICS_READ_TOKEN
R2_USAGE_ENABLED=1
R2_USAGE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_USAGE_BUCKET=YOUR_PRIVATE_STANDARD_BUCKET
PORT=7658
BIND_HOST=127.0.0.1
PUBLIC_ORIGIN=https://img.example.com
DATA_DIR=/www/wwwroot/d3ling-imgbed/data
# 仅在运营者确认未来恢复时间后填写；省略时占位图显示通用维护提示。
# IMGBED_RESTORE_AT=2030-01-01T08:00:00+08:00
